# Backend Authentication Configuration
# Set to "true" to enable authentication (default: false for single-user mode)
REQUIRE_AUTH=false

# Admin Users Configuration
# Comma-separated list of admin emails (get unlimited session time, no payment required)
# Example: ADMIN_EMAILS=owner@example.com,admin@example.com
ADMIN_EMAILS=

# JWT Secret Key (required if REQUIRE_AUTH=true in production)
# Generate a secure random key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=droxai-dev-secret-key-change-in-production

# Environment (development or production)
ENVIRONMENT=development

# Frontend Authentication Configuration  
# Set to "true" to show login/register UI (default: false)
REACT_APP_REQUIRE_AUTH=false

# API URL for frontend (default: http://localhost:8000)
REACT_APP_API_URL=http://localhost:8000
